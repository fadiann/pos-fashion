<?php 

$baseAppDir = dirname(__DIR__, 2);
if (!empty($_SERVER["DOCUMENT_ROOT"]) && file_exists($_SERVER["DOCUMENT_ROOT"] . "/pos-fashion/app")) {
    $baseAppDir = rtrim($_SERVER["DOCUMENT_ROOT"], '/\\') . "/pos-fashion";
}
if (!defined("models")) define("models", $baseAppDir . "/app/models/");
if (!defined("modules")) define("modules", $baseAppDir . "/app/modules/");
if (!defined("controllers")) define("controllers", $baseAppDir . "/app/controllers/");
if (!defined("views")) define("views", $baseAppDir . "/app/views/");
if (!defined("url")) define("url", "http://localhost/pos-fashion/");

class Database {
    public $dbhost   = "localhost";
    public $dbuser   = "root";
    public $dbpass   = "";
    public $dbname   = "pos_fashion";
    public $dbdriver = "mysqli";
    public $debug    = false;
    public $db;

    public function __construct() {
        $this->db = $this->_dbconn();
    }
    public function __destruct() {
        if ($this->db) {
            $this->db->Close();
        }
    }
    public function _dbconn() {
        $connection = ADONewConnection($this->dbdriver) or die("<h1>Tidak Dapat Membuat Koneksi Database.</h1>");
        $connection->debug  = $this->debug; 
        $connection->Connect($this->dbhost, $this->dbuser, $this->dbpass, $this->dbname) or die("<h1>Tidak Dapat Terhubung Ke Database.</h1>");
        return $connection;
    }
    public function query($sqlstr, $debug = FALSE) {
        $recordset = $this->db->Execute($sqlstr);
        if($debug == TRUE){
            echo "<pre class='bg-danger debug'>".$sqlstr."</pre>";
        }
        return $recordset;
    }
    public function bind($sql, $bind) {
        $recordset = $this->db->execute($sql, $bind);
        return $recordset;
    }
    public function assoc($sql) {
        $this->db->setFetchMode(ADODB_FETCH_ASSOC);
        $recordset = $this->db->Execute($sql)->fields;
        return $recordset;
    }
    public function assc($sqlstr, $debug = FALSE) {
		$recordset = $this->db->getAssoc($sqlstr);
        if($debug == TRUE){
            echo "<pre class='bg-danger debug'>".$sqlstr."</pre>";
        }
		return $recordset;
    } 
    public function delete($table_name, $key, $keyword) {  
        $query  = "DELETE FROM ".$table_name." WHERE ".$key."='".$keyword."'";  
        $result = $this->query($query)->recordCount();
        return $result;
    } 
}
?>
