# ==============================================================================
# POS Fashion & Retail Management System - Access Control & Security (.htaccess)
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block direct HTTP access to hidden files and directories (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct HTTP access to sensitive file extensions (configs, dumps, logs, etc.)
<FilesMatch "(?i:\.(sql|json|log|ini|lock|example|bak|backup|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Restrict Direct Web Access to Internal Application Folders
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to internal backend and configuration directories
    # Only static files in app/assets are publicly accessible
    RewriteRule ^(app/config|database|Adodb|app/models|app/modules|app/views|app/controllers|app/lib|app/print)/ - [F,L,NC]
</IfModule>

# 5. Security Headers (Defense in Depth)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
